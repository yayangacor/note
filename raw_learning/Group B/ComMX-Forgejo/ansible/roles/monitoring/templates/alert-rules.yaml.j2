apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: tpa-alerts
  namespace: monitoring
  labels:
    release: monitoring
spec:
  groups:
    - name: node-resources
      rules:
        - alert: NodeCPUHigh
          expr: 100 - (avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 90
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "CPU node {% raw %}{{ $labels.instance }}{% endraw %} di atas 90%"
            description: "Nilai saat ini {% raw %}{{ $value | printf \"%.1f\" }}{% endraw %}%"

        - alert: NodeMemoryHigh
          expr: (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 > 90
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "RAM node {% raw %}{{ $labels.instance }}{% endraw %} di atas 90%"
            description: "Nilai saat ini {% raw %}{{ $value | printf \"%.1f\" }}{% endraw %}%"

        - alert: NodeNotReady
          expr: kube_node_status_condition{condition="Ready",status="true"} == 0
          for: 5m
          labels:
            severity: critical
          annotations:
            summary: "Node {% raw %}{{ $labels.node }}{% endraw %} tidak Ready"

    - name: pod-health
      rules:
        - alert: PodNotRunning
          expr: kube_pod_status_phase{phase=~"Failed|Unknown"} > 0
          for: 2m
          labels:
            severity: warning
          annotations:
            summary: "Pod {% raw %}{{ $labels.pod }}{% endraw %} berstatus {% raw %}{{ $labels.phase }}{% endraw %}"

        - alert: PodCrashLooping
          expr: rate(kube_pod_container_status_restarts_total[15m]) > 0
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "Pod {% raw %}{{ $labels.pod }}{% endraw %} restart berulang"

        - alert: ContainerWaiting
          expr: kube_pod_container_status_waiting_reason{reason=~"CrashLoopBackOff|ImagePullBackOff|ErrImagePull"} > 0
          for: 5m
          labels:
            severity: warning
          annotations:
            summary: "Container {% raw %}{{ $labels.container }}{% endraw %} tersangkut: {% raw %}{{ $labels.reason }}{% endraw %}"
